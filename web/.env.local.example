# Copy to .env.local to enable real agent dispatch.
# Without these, the app runs entirely on inline mocks and is still fully demoable.

# Anthropic API key for dispatching real Claude calls to specialist agents.
ANTHROPIC_API_KEY=

# Set to "true" to actually dispatch real Claude calls when agent files exist
# in .claude/agents/. Default behavior (any other value) is to use mocks.
# Useful for keeping the demo predictable while teammates are still building
# their agent prompts.
USE_REAL_AGENTS=false
